# Copy to .env and fill in values. Never commit .env.
# Values below are intentionally empty. Choose your own strong values locally.

# PostgreSQL admin account (used only by the Postgres container to bootstrap; the app never uses it)
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=

# Database name and the application-only account (non-superuser)
POSTGRES_DB=cafecrowded
APP_DB_USER=
APP_DB_PASSWORD=

# Backend datasource (read by Spring Boot). Host port is bound to 127.0.0.1 only.
DB_URL=jdbc:postgresql://localhost:5432/cafecrowded
DB_USER=
DB_PASSWORD=

# Secret salt for hashing reporter addresses (random, at least 32 characters; never reuse across environments)
REPORTER_HASH_SALT=

# Allowed browser origins for CORS, comma-separated (no wildcard)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# External APIs - server-side only, never use a VITE_ prefix for these
KAKAO_REST_API_KEY=
SEOUL_OPENAPI_KEY=
